BEGIN ALGORITHM;
TITLE 'P Distance';
LINK CHARACTERS = 'Working Characters';
NAME 'P Distance';
OPTIONS
	HandleAmbiguousStates = 'Ignore';
END; [ALGORITHM]

BEGIN DISTANCES;
TITLE 'Distances';
LINK ALGORITHM = 'P Distance';
DIMENSIONS ntax=6;
FORMAT labels=left diagonal triangle=Both;
MATRIX
[1] 'An_coluzzii'          0 0.00792346 0.02414706 0.01263059 0.03618988 0.03381942
[2] 'An_gambiae'           0.00792346 0 0.02570093 0.01465544 0.03806391 0.03474484
[3] 'An_quadriannulatus'   0.02414706 0.02570093 0 0.02576186 0.04225576 0.0378539
[4] 'An_arabiensis'        0.01263059 0.01465544 0.02576186 0 0.03842505 0.03487276
[5] 'An_merus'             0.03618988 0.03806391 0.04225576 0.03842505 0 0.04271632
[6] 'An_melas'             0.03381942 0.03474484 0.0378539 0.03487276 0.04271632 0
;
END; [DISTANCES]

BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN SPLITS;
TITLE 'Splits';
LINK ALGORITHM = 'Neighbor Net';
DIMENSIONS ntax=6 nsplits=12;
FORMAT labels=no weights=yes confidences=no;
PROPERTIES fit=100 circular;
CYCLE 1 2 3 6 5 4;
MATRIX
[1, size=1] 	 0.00295149 	 1,
[2, size=2] 	 0.00021127 	 1 4,
[3, size=3] 	 0.00010647 	 1 4 5,
[4, size=1] 	 0.00465115 	 1 3 4 5 6,
[5, size=1] 	 0.00713355 	 1 2 3 5 6,
[6, size=2] 	 0.00254619 	 1 2,
[7, size=1] 	 0.02286258 	 1 2 3 4 6,
[8, size=2] 	 0.00440599 	 1 2 3 4,
[9, size=3] 	 0.00350827 	 1 2 4,
[10, size=1] 	 0.01915942 	 1 2 3 4 5,
[11, size=2] 	 0.00058403 	 1 2 4 5,
[12, size=1] 	 0.01428988 	 1 2 4 5 6,
;
END; [SPLITS]

BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'SplitNetwork';
LINK ALGORITHM = 'Show Splits';
NAME 'SplitNetworkView';
INPUT 'SPLITS';
OPTIONS
	Diagram = 'Splits',
	Orientation = 'Rotate0Deg',
	Rooting = 'None',
	ZoomFactor = 1,
	FontScaleFactor = 1,
	RootAngle = 160,
	OutlineFill = 0xffe6b3ff,
	LabelSplitsBy = 'None',
	ShowQRCode = 'false';
END; [VIEW]
