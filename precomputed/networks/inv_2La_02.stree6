BEGIN ALGORITHM;
TITLE 'P Distance';
LINK CHARACTERS = 'Working Characters';
NAME 'P Distance';
OPTIONS
	HandleAmbiguousStates = 'Ignore';
END; [ALGORITHM]

BEGIN DISTANCES;
TITLE 'Distances';
LINK ALGORITHM = 'P Distance';
DIMENSIONS ntax=6;
FORMAT labels=left diagonal triangle=Both;
MATRIX
[1] 'An_arabiensis'        0 0.03270407 0.03837263 0.0375 0.02787068 0.02580474
[2] 'An_gambiae'           0.03270407 0 0.04290278 0.03868421 0.02932227 0.02606516
[3] 'An_melas'             0.03837263 0.04290278 0 0.04271934 0.03759398 0.03197807
[4] 'An_merus'             0.0375 0.03868421 0.04271934 0 0.03215969 0.03821824
[5] 'An_quadriannulatus'   0.02787068 0.02932227 0.03759398 0.03215969 0 0.02577605
[6] 'An_coluzzii'          0.02580474 0.02606516 0.03197807 0.03821824 0.02577605 0
;
END; [DISTANCES]

BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN SPLITS;
TITLE 'Splits';
LINK ALGORITHM = 'Neighbor Net';
DIMENSIONS ntax=6 nsplits=11;
FORMAT labels=no weights=yes confidences=no;
PROPERTIES fit=99.9 circular;
CYCLE 1 2 5 4 3 6;
MATRIX
[1, size=1] 	 0.01382223 	 1,
[2, size=3] 	 0.00142716 	 1 3 6,
[3, size=1] 	 0.01567876 	 1 3 4 5 6,
[4, size=1] 	 0.00908118 	 1 2 3 4 5,
[5, size=2] 	 0.00227698 	 1 2 4 5,
[6, size=1] 	 0.01918152 	 1 2 4 5 6,
[7, size=2] 	 0.0026635 	 1 2 5 6,
[8, size=3] 	 0.00105369 	 1 2 6,
[9, size=1] 	 0.01865612 	 1 2 3 5 6,
[10, size=2] 	 0.00118662 	 1 2 3 6,
