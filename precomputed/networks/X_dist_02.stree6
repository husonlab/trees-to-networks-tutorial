BEGIN ALGORITHM;
TITLE 'P Distance';
LINK CHARACTERS = 'Working Characters';
NAME 'P Distance';
OPTIONS
	HandleAmbiguousStates = 'Ignore';
END; [ALGORITHM]

BEGIN DISTANCES;
TITLE 'Distances';
LINK ALGORITHM = 'P Distance';
DIMENSIONS ntax=6;
FORMAT labels=left diagonal triangle=Both;
MATRIX
[1] 'An_arabiensis'        0 0.04565785 0.02900961 0.04527742 0.04490629 0.05575238
[2] 'An_melas'             0.04565785 0 0.04266467 0.05110034 0.04913133 0.06128606
[3] 'An_quadriannulatus'   0.02900961 0.04266467 0 0.04385965 0.04351886 0.0543784
[4] 'An_coluzzii'          0.04527742 0.05110034 0.04385965 0 0.01068376 0.05556591
[5] 'An_gambiae'           0.04490629 0.04913133 0.04351886 0.01068376 0 0.05447761
[6] 'An_merus'             0.05575238 0.06128606 0.0543784 0.05556591 0.05447761 0
;
END; [DISTANCES]

BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN SPLITS;
TITLE 'Splits';
LINK ALGORITHM = 'Neighbor Net';
DIMENSIONS ntax=6 nsplits=11;
FORMAT labels=no weights=yes confidences=no;
PROPERTIES fit=100 circular;
CYCLE 1 3 2 5 4 6;
MATRIX
[1, size=1] 	 0.01520115 	 1,
[2, size=2] 	 0.00480523 	 1 3,
[3, size=3] 	 0.00290853 	 1 2 3,
[4, size=1] 	 0.03280928 	 1 2 3 4 5,
[5, size=1] 	 0.013004 	 1 2 4 5 6,
[6, size=2] 	 0.00080468 	 1 4 5 6,
[7, size=1] 	 0.02417133 	 1 3 4 5 6,
[8, size=2] 	 0.00065925 	 1 3 4 6,
[9, size=1] 	 0.00439102 	 1 2 3 4 6,
[10, size=2] 	 0.01684055 	 1 2 3 6,
[11, size=1] 	 0.00566218 	 1 2 3 5 6,
;
END; [SPLITS]

BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'SplitNetwork';
LINK ALGORITHM = 'Show Splits';
NAME 'SplitNetworkView';
INPUT 'SPLITS';
OPTIONS
	Diagram = 'Splits',
	Orientation = 'Rotate0Deg',
	Rooting = 'None',
	ZoomFactor = 1,
	FontScaleFactor = 1,
	RootAngle = 160,
	OutlineFill = 0xffe6b3ff,
	LabelSplitsBy = 'None',
	ShowQRCode = 'false';
END; [VIEW]
